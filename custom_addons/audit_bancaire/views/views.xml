<odoo>
	<record id="view_audit_mission_form" model="ir.ui.view">
		<field name="name">audit.mission.form</field>
		<field name="model">audit.mission</field>
		<field name="arch" type="xml">
			<form>
				<header>
					<button name="action_en_cours" string="Débuter l'audit" type="object" class="btn-primary" invisible="statut != 'brouillon'"/>
					<button name="action_termine" string="Finaliser l'audit" type="object" invisible="statut != 'en_cours'"/>
					<button name="action_brouillon" string="Remettre en brouillon" type="object" class="btn-danger" invisible="statut != 'termine'"/>
					<button name="pdf_generate" string="Générer le PDF" type="object" class="btn-success" invisible="statut != 'termine'"/>
					<field name="statut" widget="statusbar" statusbar_visible="brouillon,en_cours,termine"/>
				</header>
				<sheet>
					<group>
						<field required="1" name="name"/>
						<field name="date_audit"/>
						<field name="date_fin"/>
						<field name="entite_audit"/>
						<field name="auditeur_id"/>
						<field name="statut"/>
						<field name="observations"/>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="action_audit_mission" model="ir.actions.act_window">
		<field name="name">Mission d'audit</field>
		<field name="res_model">audit.mission</field>
		<field name="view_mode">list,form</field>
	</record>	

	<record id="view_audit_mission_list" model="ir.ui.view">
		<field name="name">audit.mission.list</field>
		<field name="model">audit.mission</field>
		<field name="arch" type="xml">
			<list>
				<field name="name"/>
				<field name="date_audit"/>
				<field name="entite_audit"/>
				<field name="auditeur_id"/>
				<field name="statut"/>
			</list>
		</field>
	</record>

	<menuitem name="Audit Bancaire" id="menu_audit_bancaire"/>
	<menuitem name="Mission d'audit" id="menu_audit_mission" parent="menu_audit_bancaire" action="action_audit_mission"/>
</odoo> 